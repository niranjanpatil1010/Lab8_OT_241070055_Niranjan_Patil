diff --git a/kernel/pstat.h b/kernel/pstat.h
new file mode 100644
index 0000000..845fd4d
--- /dev/null
+++ b/kernel/pstat.h
@@ -0,0 +1,15 @@
+#ifndef _PSTAT_H_
+#define _PSTAT_H_
+
+#include "param.h"
+
+// Per-process scheduling statistics returned by getpinfo().
+struct pstat {
+  int inuse[NPROC];     // 1 if the slot holds a live process
+  int pid[NPROC];       // process id
+  int tickets[NPROC];   // lottery tickets held (1 = default)
+  int cputicks[NPROC];  // timer ticks during which the process was running
+  int sched[NPROC];     // number of times the scheduler picked the process
+};
+
+#endif
