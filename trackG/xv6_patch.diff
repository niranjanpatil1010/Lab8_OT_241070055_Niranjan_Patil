diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..f922682
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,219 @@
+// schedbench: scheduler benchmarks for xv6 (lottery vs round-robin).
+//
+//   schedbench prop      <dur> <seed>   3 CPU hogs holding 30/20/10 tickets
+//   schedbench pingpong  <dur> <seed>   pipe ping-pong pair (50 tickets each) vs 4 CPU hogs (10 each)
+//   schedbench fair  <n> <dur> <seed>   n equal CPU hogs (fairness + throughput/overhead)
+//   schedbench forkstorm <dur> <seed>   4 processes doing fork()/exit()/wait() in a loop
+//
+// <dur> is in timer ticks. Every child reports one fixed-size record through a
+// pipe; the parent prints "RESULT ..." lines that trackG/run.py parses.
+// Run time is bounded by an absolute deadline taken from uptime().
+
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+struct rec {
+  int role;     // workload-specific role id
+  int pid;
+  int tickets;
+  int iters;    // units of useful work completed
+  int cputicks; // timer ticks charged to this process
+  int sched;    // times scheduled
+};
+
+static struct pstat st;
+
+static void
+fill_self(struct rec *r)
+{
+  int me = getpid();
+  getpinfo(&st);
+  for (int i = 0; i < NPROC; i++) {
+    if (st.inuse[i] && st.pid[i] == me) {
+      r->pid = me;
+      r->tickets = st.tickets[i];
+      r->cputicks = st.cputicks[i];
+      r->sched = st.sched[i];
+    }
+  }
+}
+
+// one "unit" of CPU work between clock reads
+static volatile int sink;
+static void
+unit(void)
+{
+  for (int i = 0; i < 20000; i++)
+    sink += i;
+}
+
+static int
+hog(int deadline)
+{
+  int n = 0;
+  while ((int)uptime() < deadline) {
+    unit();
+    n++;
+  }
+  return n;
+}
+
+// Fork a child that starts with `tickets` tickets: the parent sets its own
+// tickets first (children inherit them), then restores itself to 1. Setting
+// tickets inside the child would let the first-run child grab a huge share
+// while its siblings still hold 1 ticket (start-up starvation).
+static int
+fork_with(int tickets)
+{
+  settickets(tickets);
+  int pid = fork();
+  if (pid != 0)
+    settickets(1);
+  return pid;
+}
+
+static void
+spawn_hog(int tickets, int role, int deadline, int wfd)
+{
+  if (fork_with(tickets) == 0) {
+    struct rec r = {0};
+    r.role = role;
+    r.iters = hog(deadline);
+    fill_self(&r);
+    write(wfd, &r, sizeof(r));
+    exit(0);
+  }
+}
+
+static int
+collect(int rfd, int n, struct rec *out)
+{
+  for (int i = 0; i < n; i++)
+    if (read(rfd, &out[i], sizeof(struct rec)) != sizeof(struct rec))
+      return -1;
+  while (wait(0) > 0)
+    ;
+  return 0;
+}
+
+static void
+print_rec(const char *wl, struct rec *r)
+{
+  printf("RESULT wl=%s role=%d pid=%d tickets=%d iters=%d cputicks=%d sched=%d\n",
+         wl, r->role, r->pid, r->tickets, r->iters, r->cputicks, r->sched);
+}
+
+static void
+w_prop(int dur, int seed)
+{
+  int p[2], tix[3] = {30, 20, 10};
+  struct rec rs[3];
+  schedseed(seed);
+  pipe(p);
+  int deadline = uptime() + dur;
+  for (int i = 0; i < 3; i++)
+    spawn_hog(tix[i], i, deadline, p[1]);
+  if (collect(p[0], 3, rs) < 0) { printf("ERROR prop\n"); return; }
+  for (int i = 0; i < 3; i++) print_rec("prop", &rs[i]);
+}
+
+static void
+w_fair(int n, int dur, int seed)
+{
+  int p[2];
+  struct rec rs[16];
+  if (n > 16) n = 16;
+  schedseed(seed);
+  pipe(p);
+  int deadline = uptime() + dur;
+  for (int i = 0; i < n; i++)
+    spawn_hog(10, i, deadline, p[1]);
+  if (collect(p[0], n, rs) < 0) { printf("ERROR fair\n"); return; }
+  for (int i = 0; i < n; i++) print_rec(n == 1 ? "solo" : "fair", &rs[i]);
+}
+
+static void
+w_pingpong(int dur, int seed)
+{
+  int p[2], ab[2], ba[2];
+  struct rec rs[5];
+  schedseed(seed);
+  pipe(p);
+  pipe(ab);
+  pipe(ba);
+  int deadline = uptime() + dur;
+  for (int i = 0; i < 4; i++)
+    spawn_hog(10, 1, deadline, p[1]);
+  // echoer B: reads from ab, writes to ba, until ab is closed by A
+  if (fork_with(50) == 0) {
+    char c;
+    close(ab[1]); close(ba[0]); close(p[0]);
+    while (read(ab[0], &c, 1) == 1)
+      write(ba[1], &c, 1);
+    exit(0);
+  }
+  // pinger A: counts completed round trips, reports
+  if (fork_with(50) == 0) {
+    struct rec r = {0};
+    char c = 'x';
+    close(ab[0]); close(ba[1]); close(p[0]);
+    while ((int)uptime() < deadline) {
+      write(ab[1], &c, 1);
+      if (read(ba[0], &c, 1) != 1) break;
+      r.iters++;
+    }
+    r.role = 0;
+    fill_self(&r);
+    write(p[1], &r, sizeof(r));
+    close(ab[1]); // lets B see EOF
+    exit(0);
+  }
+  close(ab[0]); close(ab[1]); close(ba[0]); close(ba[1]);
+  if (collect(p[0], 5, rs) < 0) { printf("ERROR pingpong\n"); return; }
+  for (int i = 0; i < 5; i++) print_rec("pingpong", &rs[i]);
+}
+
+static void
+w_forkstorm(int dur, int seed)
+{
+  int p[2];
+  struct rec rs[4];
+  schedseed(seed);
+  pipe(p);
+  int deadline = uptime() + dur;
+  for (int i = 0; i < 4; i++) {
+    if (fork_with(10) == 0) {
+      struct rec r = {0};
+      r.role = i;
+      while ((int)uptime() < deadline) {
+        int pid = fork();
+        if (pid == 0)
+          exit(0);
+        wait(0);
+        r.iters++;
+      }
+      fill_self(&r);
+      write(p[1], &r, sizeof(r));
+      exit(0);
+    }
+  }
+  if (collect(p[0], 4, rs) < 0) { printf("ERROR forkstorm\n"); return; }
+  for (int i = 0; i < 4; i++) print_rec("forkstorm", &rs[i]);
+}
+
+int
+main(int argc, char *argv[])
+{
+  if (argc < 4) {
+    printf("usage: schedbench prop|pingpong|forkstorm <dur> <seed> | fair <n> <dur> <seed>\n");
+    exit(1);
+  }
+  if (!strcmp(argv[1], "prop")) w_prop(atoi(argv[2]), atoi(argv[3]));
+  else if (!strcmp(argv[1], "pingpong")) w_pingpong(atoi(argv[2]), atoi(argv[3]));
+  else if (!strcmp(argv[1], "forkstorm")) w_forkstorm(atoi(argv[2]), atoi(argv[3]));
+  else if (!strcmp(argv[1], "fair") && argc >= 5) w_fair(atoi(argv[2]), atoi(argv[3]), atoi(argv[4]));
+  else { printf("bad args\n"); exit(1); }
+  exit(0);
+}
