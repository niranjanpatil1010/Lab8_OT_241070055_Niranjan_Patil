         // to release its lock and then reacquire it
         // before jumping back to us.
         p->state = RUNNING;
+        p->sched++;
         c->proc = p;
         swtch(&c->context, &p->context);
 
@@ -466,7 +514,77 @@ scheduler(void)
       // nothing to run; stop running on this core until an interrupt.
       asm volatile("wfi");
     }
+#endif
+  }
+}
+
+// ---- lottery-scheduler support (accounting + syscalls) ----
+
+uint
+lottery_rand(void)
+{
+  uint x;
+  acquire(&lottery_lock);
+  x = lottery_state;
+  x ^= x << 13;
+  x ^= x >> 17;
+  x ^= x << 5;
+  lottery_state = x;
+  release(&lottery_lock);
+  return x;
+}
+
+int
+schedseed(int seed)
+{
+  acquire(&lottery_lock);
+  lottery_state = seed ? (uint)seed : 1; // xorshift state must be non-zero
+  release(&lottery_lock);
+  return 0;
+}
+
+// Called from the timer-interrupt path: charge one tick to the running process.
+void
+charge_tick(void)
+{
+  struct proc *p = myproc();
+  if (p == 0)
+    return;
+  acquire(&p->lock);
+  p->cputicks++;
+  release(&p->lock);
+}
+
+int
+settickets(int n)
+{
+  struct proc *p = myproc();
+  if (n < 1)
+    return -1;
+  acquire(&p->lock);
+  p->tickets = n;
+  release(&p->lock);
+  return 0;
+}
+
+int
+getpinfo(uint64 addr)
+{
+  struct pstat st;
+  struct proc *p;
+  int i = 0;
+  for (p = proc; p < &proc[NPROC]; p++, i++) {
+    acquire(&p->lock);
+    st.inuse[i] = (p->state != UNUSED);
+    st.pid[i] = p->pid;
+    st.tickets[i] = p->tickets;
+    st.cputicks[i] = p->cputicks;
+    st.sched[i] = p->sched;
+    release(&p->lock);
   }
+  if (copyout(myproc()->pagetable, myproc()->sz, addr, (char *)&st, sizeof(st)) < 0)
+    return -1;
+  return 0;
 }
 
 // Switch to scheduler.  Must hold only p->lock
