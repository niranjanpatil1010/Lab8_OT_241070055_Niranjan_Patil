+          p->sched++;
+          c->proc = p;
+          swtch(&c->context, &p->context);
+          mycpu()->intena = 0;
+          c->proc = 0;
+          release(&p->lock);
+          break;
+        }
+      }
+      release(&p->lock);
+    }
